{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@ai-office/contracts": ["packages/contracts/src/index.ts"],
      "@ai-office/contracts/*": ["packages/contracts/src/*/index.ts"],
      "@ai-office/domain": ["packages/domain/src/index.ts"],
      "@ai-office/engine": ["packages/engine/src/index.ts"],
      "@ai-office/projection": ["packages/projection/src/index.ts"],
      "@ai-office/templates": ["packages/templates/src/index.ts"]
    }
  },
  "include": ["apps/**/*.ts", "apps/**/*.tsx", "packages/**/*.ts"]
}
