{
  "name": "@ai-office/server",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "import": "./dist/main.js"
    }
  },
  "scripts": {
    "build": "tsc -b && node -e \"require('node:fs').cpSync('src/adapters/store-sqlite/migrations','dist/adapters/store-sqlite/migrations',{recursive:true,filter:(f)=>!/\\\\.ts$/.test(f)})\"",
    "start": "node dist/main.js",
    "test": "pnpm --workspace-root exec vitest run --config vitest.config.ts --project @ai-office/server"
  },
  "dependencies": {
    "@ai-office/contracts": "workspace:*",
    "@ai-office/domain": "workspace:*",
    "@ai-office/engine": "workspace:*",
    "@ai-office/projection": "workspace:*",
    "@ai-office/templates": "workspace:*",
    "@fastify/cookie": "^11.1.5",
    "@fastify/static": "^10.1.11",
    "better-sqlite3": "^13.2.0",
    "fastify": "^5.6.2",
    "fastify-type-provider-zod": "^7.0.0",
    "pino": "^10.4.0",
    "smol-toml": "^1.9.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7",
    "@ai-office/redaction": "workspace:*"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.10.0"
  }
}
