{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "event": {
          "type": "string",
          "const": "domain"
        },
        "id": {
          "type": "string",
          "pattern": "^\\d+$"
        },
        "data": {
          "$ref": "./DomainEvent.schema.json"
        }
      },
      "required": [
        "event",
        "id",
        "data"
      ]
    },
    {
      "type": "object",
      "properties": {
        "event": {
          "type": "string",
          "const": "resync_required"
        },
        "data": {
          "type": "object",
          "properties": {
            "reason": {
              "type": "string"
            }
          }
        }
      },
      "required": [
        "event"
      ]
    },
    {
      "type": "object",
      "properties": {
        "event": {
          "type": "string",
          "const": "keepalive"
        },
        "comment": {
          "type": "string",
          "const": "keepalive"
        }
      },
      "required": [
        "event",
        "comment"
      ]
    }
  ]
}
