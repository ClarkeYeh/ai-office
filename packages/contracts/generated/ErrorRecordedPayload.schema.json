{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "category": {
      "$ref": "./ErrorCategory.schema.json"
    },
    "code": {
      "type": "string",
      "minLength": 1
    },
    "message": {
      "type": "string"
    },
    "commandId": {
      "type": "string",
      "minLength": 1
    },
    "detail": {
      "type": "string"
    }
  },
  "required": [
    "category",
    "code",
    "message"
  ]
}
