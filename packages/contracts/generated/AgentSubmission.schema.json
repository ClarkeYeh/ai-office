{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "agenda"
        },
        "payload": {
          "type": "object",
          "properties": {
            "topics": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "title": {
                    "type": "string"
                  },
                  "focusByRole": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {
                      "type": "string"
                    }
                  }
                },
                "required": [
                  "id",
                  "title",
                  "focusByRole"
                ]
              }
            }
          },
          "required": [
            "topics"
          ]
        }
      },
      "required": [
        "kind",
        "payload"
      ]
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "statement"
        },
        "payload": {
          "type": "object",
          "properties": {
            "round": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "position": {
              "type": "string"
            },
            "arguments": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "concerns": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "readyToConclude": {
              "type": "boolean"
            }
          },
          "required": [
            "round",
            "position",
            "arguments",
            "concerns",
            "readyToConclude"
          ]
        }
      },
      "required": [
        "kind",
        "payload"
      ]
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "conclusion"
        },
        "payload": {
          "type": "object",
          "properties": {
            "summary": {
              "type": "string"
            },
            "decisions": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string"
                  },
                  "rationale": {
                    "type": "string"
                  }
                },
                "required": [
                  "title",
                  "rationale"
                ]
              }
            },
            "techDecisions": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "topic": {
                    "type": "string"
                  },
                  "options": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "chosen": {
                    "type": "string"
                  },
                  "rationale": {
                    "type": "string"
                  }
                },
                "required": [
                  "topic",
                  "options",
                  "chosen",
                  "rationale"
                ]
              }
            },
            "openQuestions": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "summary",
            "decisions",
            "techDecisions",
            "openQuestions"
          ]
        }
      },
      "required": [
        "kind",
        "payload"
      ]
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "work-items"
        },
        "payload": {
          "type": "object",
          "properties": {
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "key": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
                  },
                  "title": {
                    "type": "string"
                  },
                  "body": {
                    "type": "string"
                  },
                  "acceptance": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "role": {
                    "type": "string",
                    "minLength": 1
                  },
                  "agent": {
                    "type": "string",
                    "enum": [
                      "claude-code",
                      "codex"
                    ]
                  },
                  "deps": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
                    }
                  }
                },
                "required": [
                  "key",
                  "title",
                  "body",
                  "acceptance",
                  "role",
                  "deps"
                ]
              }
            }
          },
          "required": [
            "items"
          ]
        }
      },
      "required": [
        "kind",
        "payload"
      ]
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "answer-question"
        },
        "payload": {
          "type": "object",
          "properties": {
            "questionId": {
              "type": "string",
              "minLength": 1
            },
            "body": {
              "type": "string"
            }
          },
          "required": [
            "questionId",
            "body"
          ]
        }
      },
      "required": [
        "kind",
        "payload"
      ]
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "merge-request"
        },
        "payload": {
          "type": "object",
          "properties": {
            "pr": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "expectedHeadSha": {
              "type": "string",
              "pattern": "^[0-9a-f]{7,64}$"
            }
          },
          "required": [
            "pr",
            "expectedHeadSha"
          ]
        }
      },
      "required": [
        "kind",
        "payload"
      ]
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "decision-request"
        },
        "payload": {
          "type": "object",
          "properties": {
            "reason": {
              "type": "string",
              "enum": [
                "unresolvable-conflict",
                "scope-change",
                "conflicts-with-conclusion",
                "other"
              ]
            },
            "question": {
              "type": "string"
            },
            "options": {
              "maxItems": 4,
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "questionId": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "reason",
            "question",
            "options"
          ]
        }
      },
      "required": [
        "kind",
        "payload"
      ]
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "integration-report"
        },
        "payload": {
          "type": "object",
          "properties": {
            "summary": {
              "type": "string"
            },
            "merged": {
              "type": "array",
              "items": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            },
            "verification": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "command": {
                    "type": "string"
                  },
                  "ok": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "command",
                  "ok"
                ]
              }
            },
            "risks": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "summary",
            "merged",
            "verification",
            "risks"
          ]
        }
      },
      "required": [
        "kind",
        "payload"
      ]
    }
  ]
}
