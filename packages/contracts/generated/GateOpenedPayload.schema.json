{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "gateId": {
          "type": "string",
          "minLength": 1
        },
        "stageId": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "optionId": {
                "type": "string",
                "minLength": 1
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "input": {
                "type": "string",
                "enum": [
                  "tokens",
                  "agent",
                  "text"
                ]
              }
            },
            "required": [
              "optionId",
              "label"
            ]
          }
        },
        "content": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "conclusion"
                },
                "artifactId": {
                  "type": "string",
                  "minLength": 1
                },
                "renderedHash": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "required": [
                "type",
                "artifactId",
                "renderedHash"
              ]
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "work-items"
                },
                "artifactId": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "type",
                "artifactId"
              ]
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "final-pr"
                },
                "artifactId": {
                  "type": "string",
                  "minLength": 1
                },
                "pr": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "type",
                "artifactId"
              ]
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "exception"
                },
                "summary": {
                  "type": "string"
                },
                "attemptId": {
                  "type": "string",
                  "minLength": 1
                },
                "itemKey": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
                },
                "questionId": {
                  "type": "string",
                  "minLength": 1
                },
                "commandId": {
                  "type": "string",
                  "minLength": 1
                },
                "triggerEventId": {
                  "type": "string",
                  "minLength": 1
                },
                "decisionRequest": {
                  "type": "object",
                  "properties": {
                    "reason": {
                      "type": "string",
                      "enum": [
                        "unresolvable-conflict",
                        "scope-change",
                        "conflicts-with-conclusion",
                        "other"
                      ]
                    },
                    "question": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "reason",
                    "question"
                  ]
                },
                "changedFiles": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "type",
                "summary"
              ]
            }
          ]
        },
        "version": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "kind": {
          "type": "string",
          "const": "stage"
        },
        "templateGateId": {
          "type": "string",
          "minLength": 1
        },
        "stageKind": {
          "type": "string",
          "enum": [
            "meeting",
            "planning",
            "final-pr"
          ]
        },
        "optional": {
          "type": "boolean"
        }
      },
      "required": [
        "gateId",
        "stageId",
        "title",
        "options",
        "content",
        "version",
        "kind",
        "templateGateId",
        "stageKind",
        "optional"
      ]
    },
    {
      "type": "object",
      "properties": {
        "gateId": {
          "type": "string",
          "minLength": 1
        },
        "stageId": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "optionId": {
                "type": "string",
                "minLength": 1
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "input": {
                "type": "string",
                "enum": [
                  "tokens",
                  "agent",
                  "text"
                ]
              }
            },
            "required": [
              "optionId",
              "label"
            ]
          }
        },
        "content": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "conclusion"
                },
                "artifactId": {
                  "type": "string",
                  "minLength": 1
                },
                "renderedHash": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "required": [
                "type",
                "artifactId",
                "renderedHash"
              ]
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "work-items"
                },
                "artifactId": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "type",
                "artifactId"
              ]
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "final-pr"
                },
                "artifactId": {
                  "type": "string",
                  "minLength": 1
                },
                "pr": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "type",
                "artifactId"
              ]
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "exception"
                },
                "summary": {
                  "type": "string"
                },
                "attemptId": {
                  "type": "string",
                  "minLength": 1
                },
                "itemKey": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
                },
                "questionId": {
                  "type": "string",
                  "minLength": 1
                },
                "commandId": {
                  "type": "string",
                  "minLength": 1
                },
                "triggerEventId": {
                  "type": "string",
                  "minLength": 1
                },
                "decisionRequest": {
                  "type": "object",
                  "properties": {
                    "reason": {
                      "type": "string",
                      "enum": [
                        "unresolvable-conflict",
                        "scope-change",
                        "conflicts-with-conclusion",
                        "other"
                      ]
                    },
                    "question": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "reason",
                    "question"
                  ]
                },
                "changedFiles": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "type",
                "summary"
              ]
            }
          ]
        },
        "version": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "kind": {
          "type": "string",
          "const": "exception"
        },
        "exceptionKind": {
          "type": "string",
          "enum": [
            "stage-violation",
            "workitem-failed",
            "budget-exceeded",
            "budget-hard-limit",
            "item-budget-exceeded",
            "item-budget-hard-limit",
            "decision-request",
            "question-escalation",
            "anomaly",
            "hijacked"
          ]
        }
      },
      "required": [
        "gateId",
        "stageId",
        "title",
        "options",
        "content",
        "version",
        "kind",
        "exceptionKind"
      ]
    }
  ]
}
