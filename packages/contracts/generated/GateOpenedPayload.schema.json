{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "gateId": {
          "type": "string",
          "minLength": 1
        },
        "stageId": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "options": {
          "type": "array",
          "items": {
            "$ref": "./GateOption.schema.json"
          }
        },
        "content": {
          "$ref": "./GateContent.schema.json"
        },
        "version": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "kind": {
          "type": "string",
          "const": "stage"
        },
        "templateGateId": {
          "type": "string",
          "minLength": 1
        },
        "stageKind": {
          "type": "string",
          "enum": [
            "meeting",
            "planning",
            "final-pr"
          ]
        },
        "optional": {
          "type": "boolean"
        }
      },
      "required": [
        "gateId",
        "stageId",
        "title",
        "options",
        "content",
        "version",
        "kind",
        "templateGateId",
        "stageKind",
        "optional"
      ]
    },
    {
      "type": "object",
      "properties": {
        "gateId": {
          "type": "string",
          "minLength": 1
        },
        "stageId": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "options": {
          "type": "array",
          "items": {
            "$ref": "./GateOption.schema.json"
          }
        },
        "content": {
          "$ref": "./GateContent.schema.json"
        },
        "version": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "kind": {
          "type": "string",
          "const": "exception"
        },
        "exceptionKind": {
          "$ref": "./ExceptionKind.schema.json"
        }
      },
      "required": [
        "gateId",
        "stageId",
        "title",
        "options",
        "content",
        "version",
        "kind",
        "exceptionKind"
      ]
    }
  ]
}
