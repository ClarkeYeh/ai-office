{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "gateId": {
      "type": "string",
      "minLength": 1
    },
    "reason": {
      "type": "string",
      "enum": [
        "merged",
        "cancelled",
        "superseded"
      ]
    }
  },
  "required": [
    "gateId",
    "reason"
  ]
}
