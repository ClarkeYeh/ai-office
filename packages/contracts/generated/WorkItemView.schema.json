{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "key": {
      "$ref": "./WorkItemKey.schema.json"
    },
    "title": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "acceptance": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "role": {
      "type": "string",
      "minLength": 1
    },
    "agent": {
      "$ref": "./AgentKind.schema.json"
    },
    "deps": {
      "type": "array",
      "items": {
        "$ref": "./WorkItemKey.schema.json"
      }
    },
    "status": {
      "$ref": "./WorkItemStatus.schema.json"
    },
    "attempts": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "currentAttemptId": {
      "type": "string",
      "minLength": 1
    },
    "seatId": {
      "$ref": "./SeatId.schema.json"
    },
    "branch": {
      "type": "string"
    },
    "workspaceName": {
      "type": "string",
      "minLength": 1
    },
    "issue": {
      "type": "object",
      "properties": {
        "number": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": [
        "number"
      ]
    },
    "pr": {
      "$ref": "./PrSummary.schema.json"
    },
    "headSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{7,64}$"
    },
    "baseSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{7,64}$"
    },
    "reworks": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "mergeCommitSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{7,64}$"
    },
    "reason": {
      "type": "string"
    },
    "usage": {
      "$ref": "./TokenUsage.schema.json"
    }
  },
  "required": [
    "key",
    "title",
    "body",
    "acceptance",
    "role",
    "deps",
    "status",
    "attempts",
    "reworks",
    "usage"
  ]
}
