{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "conclusion"
        },
        "artifactId": {
          "type": "string",
          "minLength": 1
        },
        "renderedHash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "type",
        "artifactId",
        "renderedHash"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "work-items"
        },
        "artifactId": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "type",
        "artifactId"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "final-pr"
        },
        "artifactId": {
          "type": "string",
          "minLength": 1
        },
        "pr": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "prClosedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        }
      },
      "required": [
        "type",
        "artifactId"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "exception"
        },
        "summary": {
          "type": "string"
        },
        "attemptId": {
          "type": "string",
          "minLength": 1
        },
        "itemKey": {
          "$ref": "./WorkItemKey.schema.json"
        },
        "questionId": {
          "type": "string",
          "minLength": 1
        },
        "commandId": {
          "type": "string",
          "minLength": 1
        },
        "triggerEventId": {
          "type": "string",
          "minLength": 1
        },
        "decisionRequest": {
          "type": "object",
          "properties": {
            "reason": {
              "$ref": "./DecisionRequestReason.schema.json"
            },
            "question": {
              "type": "string"
            }
          },
          "required": [
            "reason",
            "question"
          ]
        },
        "changedFiles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "type",
        "summary"
      ]
    }
  ]
}
