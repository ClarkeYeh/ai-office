{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "workflowId": {
      "type": "string",
      "minLength": 1
    },
    "shortId": {
      "type": "string",
      "minLength": 1
    },
    "templateId": {
      "type": "string",
      "minLength": 1
    },
    "templateName": {
      "type": "string"
    },
    "repoId": {
      "type": "string",
      "minLength": 1
    },
    "repoFullName": {
      "type": "string",
      "minLength": 1
    },
    "requirement": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "$ref": "./WorkflowStatus.schema.json"
    },
    "pausedReasons": {
      "type": "array",
      "items": {
        "$ref": "./PauseReason.schema.json"
      }
    },
    "currentStageId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "currentStageKind": {
      "anyOf": [
        {
          "$ref": "./StageKind.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "progress": {
      "type": "object",
      "properties": {
        "stagesDone": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "stagesTotal": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "stagesDone",
        "stagesTotal"
      ]
    },
    "openGates": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "escalatedQuestions": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "budgetTokens": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "workflowBudgetTokens": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "startedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "endedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    }
  },
  "required": [
    "workflowId",
    "shortId",
    "templateId",
    "templateName",
    "repoId",
    "repoFullName",
    "requirement",
    "status",
    "pausedReasons",
    "currentStageId",
    "currentStageKind",
    "progress",
    "openGates",
    "escalatedQuestions",
    "budgetTokens",
    "startedAt"
  ]
}
