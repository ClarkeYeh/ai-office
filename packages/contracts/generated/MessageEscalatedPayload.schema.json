{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "questionId": {
      "type": "string",
      "minLength": 1
    },
    "reason": {
      "type": "string",
      "enum": [
        "timeout",
        "decision-request",
        "oncall-failed",
        "no-responder"
      ]
    },
    "gateId": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "questionId",
    "reason",
    "gateId"
  ]
}
