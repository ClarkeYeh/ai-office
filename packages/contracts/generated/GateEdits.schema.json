{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "conclusion"
        },
        "conclusion": {
          "type": "object",
          "properties": {
            "summary": {
              "type": "string"
            },
            "decisions": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string"
                  },
                  "rationale": {
                    "type": "string"
                  }
                },
                "required": [
                  "title",
                  "rationale"
                ]
              }
            },
            "techDecisions": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "topic": {
                    "type": "string"
                  },
                  "options": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "chosen": {
                    "type": "string"
                  },
                  "rationale": {
                    "type": "string"
                  }
                },
                "required": [
                  "topic",
                  "options",
                  "chosen",
                  "rationale"
                ]
              }
            },
            "openQuestions": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "summary",
            "decisions",
            "techDecisions",
            "openQuestions"
          ]
        }
      },
      "required": [
        "type",
        "conclusion"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "work-items"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
              },
              "title": {
                "type": "string"
              },
              "body": {
                "type": "string"
              },
              "acceptance": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "role": {
                "type": "string",
                "minLength": 1
              },
              "agent": {
                "type": "string",
                "enum": [
                  "claude-code",
                  "codex"
                ]
              },
              "deps": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
                }
              }
            },
            "required": [
              "key",
              "title",
              "body",
              "acceptance",
              "role",
              "deps"
            ]
          }
        }
      },
      "required": [
        "type",
        "items"
      ]
    }
  ]
}
