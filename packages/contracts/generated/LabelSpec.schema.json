{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "color": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{6}$"
    },
    "description": {
      "type": "string"
    }
  },
  "required": [
    "name"
  ]
}
