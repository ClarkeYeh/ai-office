        },
        "stageId": {
          "type": "string",
          "minLength": 1
        },
        "stageAttempt": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "metric",
        "used",
        "budget",
        "threshold",
        "scope",
        "stageId",
        "stageAttempt"
      ]
    },
    {
      "type": "object",
      "properties": {
