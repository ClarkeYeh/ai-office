{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "questionId": {
      "type": "string",
      "minLength": 1
    },
    "workflowId": {
      "type": "string",
      "minLength": 1
    },
    "attemptId": {
      "type": "string",
      "minLength": 1
    },
    "seatId": {
      "$ref": "./SeatId.schema.json"
    },
    "role": {
      "type": "string",
      "minLength": 1
    },
    "itemKey": {
      "$ref": "./WorkItemKey.schema.json"
    },
    "body": {
      "type": "string"
    },
    "status": {
      "$ref": "./QuestionStatus.schema.json"
    },
    "askedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "forwardedTo": {
      "type": "string",
      "enum": [
        "facilitator",
        "on-call"
      ]
    },
    "escalation": {
      "type": "object",
      "properties": {
        "reason": {
          "type": "string",
          "enum": [
            "timeout",
            "decision-request",
            "oncall-failed",
            "no-responder"
          ]
        },
        "gateId": {
          "type": "string",
          "minLength": 1
        },
        "at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "options": {
          "type": "array",
          "items": {
            "$ref": "./GateOption.schema.json"
          }
        }
      },
      "required": [
        "reason",
        "gateId",
        "at",
        "options"
      ]
    },
    "answer": {
      "type": "object",
      "properties": {
        "by": {
          "type": "string",
          "enum": [
            "agent",
            "user"
          ]
        },
        "body": {
          "type": "string"
        },
        "at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "optionId": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "by",
        "body",
        "at"
      ]
    }
  },
  "required": [
    "questionId",
    "workflowId",
    "attemptId",
    "seatId",
    "role",
    "body",
    "status",
    "askedAt"
  ]
}
