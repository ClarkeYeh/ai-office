{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "acceptance": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "role": {
      "type": "string",
      "minLength": 1
    },
    "agent": {
      "type": "string",
      "enum": [
        "claude-code",
        "codex"
      ]
    },
    "deps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "key",
    "title",
    "body",
    "acceptance",
    "role",
    "deps"
  ]
}
