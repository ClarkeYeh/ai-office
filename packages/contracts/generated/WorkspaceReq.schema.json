{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "new-worktree"
        },
        "baseBranch": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "branch": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind",
        "baseBranch",
        "name",
        "branch"
      ]
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "existing-worktree"
        },
        "workspace": {
          "type": "string",
          "minLength": 1
        },
        "readOnly": {
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "workspace",
        "readOnly"
      ]
    }
  ]
}
