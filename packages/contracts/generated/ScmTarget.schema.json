{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "repo": {
      "$ref": "./RepoScmRef.schema.json"
    },
    "number": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "type": {
      "type": "string",
      "enum": [
        "issue",
        "pr"
      ]
    }
  },
  "required": [
    "repo",
    "number",
    "type"
  ]
}
