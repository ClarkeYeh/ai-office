{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "itemKey": {
      "$ref": "./WorkItemKey.schema.json"
    },
    "status": {
      "$ref": "./WorkItemStatus.schema.json"
    },
    "attemptId": {
      "type": "string",
      "minLength": 1
    },
    "issue": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "pr": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "headSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{7,64}$"
    },
    "reason": {
      "type": "string"
    }
  },
  "required": [
    "itemKey",
    "status"
  ]
}
