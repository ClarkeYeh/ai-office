{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "const": "meeting"
        },
        "escalateOn": {
          "not": {}
        },
        "facilitator": {
          "type": "string",
          "minLength": 1
        },
        "participants": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "maxRounds": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "timeouts": {
          "type": "object",
          "properties": {
            "roundMin": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "stageMin": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "roundMin",
            "stageMin"
          ]
        },
        "budget": {
          "$ref": "./Budget.schema.json"
        },
        "conclusion": {
          "type": "object",
          "properties": {
            "requireTechDecisions": {
              "type": "boolean"
            }
          },
          "required": [
            "requireTechDecisions"
          ]
        },
        "gate": {
          "$ref": "./Gate.schema.json"
        }
      },
      "required": [
        "id",
        "kind",
        "facilitator",
        "participants",
        "maxRounds",
        "timeouts",
        "budget",
        "conclusion",
        "gate"
      ]
    },
    {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "const": "planning"
        },
        "escalateOn": {
          "not": {}
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "from": {
          "type": "string",
          "minLength": 1
        },
        "timeouts": {
          "type": "object",
          "properties": {
            "stageMin": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "stageMin"
          ]
        },
        "budget": {
          "$ref": "./Budget.schema.json"
        },
        "gate": {
          "$ref": "./Gate.schema.json"
        }
      },
      "required": [
        "id",
        "kind",
        "owner",
        "from",
        "timeouts",
        "budget",
        "gate"
      ]
    },
    {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "const": "implement"
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "from": {
          "type": "string",
          "minLength": 1
        },
        "maxParallel": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "timeouts": {
          "type": "object",
          "properties": {
            "itemMin": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "itemMin"
          ]
        },
        "budget": {
          "$ref": "./Budget.schema.json"
        },
        "onCall": {
          "type": "object",
          "properties": {
            "role": {
              "type": "string",
              "minLength": 1
            },
            "questionTimeoutMin": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "role",
            "questionTimeoutMin"
          ]
        },
        "mergeQueue": {
          "type": "object",
          "properties": {
            "role": {
              "type": "string",
              "minLength": 1
            },
            "reviewTimeoutMin": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "maxRework": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "role",
            "reviewTimeoutMin"
          ]
        },
        "escalateOn": {
          "$ref": "./EscalateOn.schema.json"
        }
      },
      "required": [
        "id",
        "kind",
        "role",
        "from",
        "maxParallel",
        "timeouts",
        "budget",
        "onCall",
        "mergeQueue",
        "escalateOn"
      ]
    },
    {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "const": "integrate"
        },
        "escalateOn": {
          "not": {}
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "timeouts": {
          "type": "object",
          "properties": {
            "stageMin": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "stageMin"
          ]
        },
        "budget": {
          "$ref": "./Budget.schema.json"
        }
      },
      "required": [
        "id",
        "kind",
        "owner",
        "timeouts",
        "budget"
      ]
    },
    {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "const": "final-pr"
        },
        "escalateOn": {
          "not": {}
        },
        "maxRevisions": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "gate": {
          "$ref": "./Gate.schema.json"
        }
      },
      "required": [
        "id",
        "kind",
        "maxRevisions",
        "gate"
      ]
    }
  ]
}
