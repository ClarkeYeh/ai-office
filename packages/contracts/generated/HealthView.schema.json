{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "healthy",
        "degraded",
        "unhealthy"
      ]
    },
    "runtime": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "healthy",
            "degraded",
            "unhealthy"
          ]
        },
        "breaker": {
          "type": "string",
          "enum": [
            "closed",
            "open",
            "half_open"
          ]
        },
        "detail": {
          "type": "string"
        },
        "checkedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "mode": {
          "type": "string",
          "enum": [
            "orca",
            "fake"
          ]
        },
        "version": {
          "type": "string"
        },
        "verified": {
          "type": "boolean"
        },
        "shim": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "ok",
                "missing",
                "rebuilding"
              ]
            },
            "location": {
              "type": "string"
            }
          },
          "required": [
            "status"
          ]
        },
        "runOwned": {
          "type": "boolean"
        },
        "cliCallsPerMinute": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "binPath": {
          "type": "string"
        },
        "supportedRange": {
          "type": "string"
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cpuSecondsPerMinute": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "status",
        "mode",
        "verified"
      ]
    },
    "scm": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "healthy",
            "degraded",
            "unhealthy"
          ]
        },
        "breaker": {
          "type": "string",
          "enum": [
            "closed",
            "open",
            "half_open"
          ]
        },
        "detail": {
          "type": "string"
        },
        "checkedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "login": {
          "type": "string",
          "minLength": 1
        },
        "ghBinPath": {
          "type": "string"
        },
        "rateLimit": {
          "type": "object",
          "properties": {
            "limit": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "remaining": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "resetAt": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
            }
          },
          "required": [
            "limit",
            "remaining",
            "resetAt"
          ]
        }
      },
      "required": [
        "status"
      ]
    },
    "store": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "healthy",
            "degraded",
            "unhealthy"
          ]
        },
        "breaker": {
          "type": "string",
          "enum": [
            "closed",
            "open",
            "half_open"
          ]
        },
        "detail": {
          "type": "string"
        },
        "checkedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        }
      },
      "required": [
        "status"
      ]
    },
    "usage": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "healthy",
            "degraded",
            "unhealthy"
          ]
        },
        "breaker": {
          "type": "string",
          "enum": [
            "closed",
            "open",
            "half_open"
          ]
        },
        "detail": {
          "type": "string"
        },
        "checkedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "agent": {
                "$ref": "./AgentKind.schema.json"
              },
              "source": {
                "type": "string"
              },
              "available": {
                "type": "boolean"
              },
              "formatVerified": {
                "type": "boolean"
              }
            },
            "required": [
              "agent",
              "source",
              "available"
            ]
          }
        }
      },
      "required": [
        "status",
        "sources"
      ]
    },
    "adapters": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "adapter": {
            "type": "string",
            "minLength": 1
          },
          "calls": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "failures": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "p50Ms": {
            "type": "number",
            "minimum": 0
          },
          "p95Ms": {
            "type": "number",
            "minimum": 0
          },
          "failureRate": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "lastErrorCategory": {
            "$ref": "./ErrorCategory.schema.json"
          }
        },
        "required": [
          "adapter",
          "calls",
          "failures"
        ]
      }
    }
  },
  "required": [
    "status",
    "runtime",
    "scm",
    "store",
    "usage",
    "adapters"
  ]
}
