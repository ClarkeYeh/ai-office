{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "attemptId": {
      "type": "string",
      "minLength": 1
    },
    "activity": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "messageId": {
            "type": "string",
            "minLength": 1
          },
          "tool": {
            "type": "string"
          },
          "category": {
            "type": "string",
            "enum": [
              "read",
              "edit",
              "shell",
              "git",
              "network",
              "orca",
              "other"
            ]
          },
          "ok": {
            "type": "boolean"
          },
          "durationMs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "inputLen": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "outputLen": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "inputHash": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "messageId",
          "category",
          "inputLen",
          "outputLen",
          "inputHash"
        ]
      }
    }
  },
  "required": [
    "attemptId",
    "activity"
  ]
}
