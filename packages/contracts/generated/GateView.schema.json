{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "gateId": {
      "type": "string",
      "minLength": 1
    },
    "workflowId": {
      "type": "string",
      "minLength": 1
    },
    "stageId": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "enum": [
        "stage",
        "exception"
      ]
    },
    "templateGateId": {
      "type": "string",
      "minLength": 1
    },
    "stageKind": {
      "type": "string",
      "enum": [
        "meeting",
        "planning",
        "final-pr"
      ]
    },
    "optional": {
      "type": "boolean"
    },
    "exceptionKind": {
      "$ref": "./ExceptionKind.schema.json"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "$ref": "./GateStatus.schema.json"
    },
    "version": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "options": {
      "type": "array",
      "items": {
        "$ref": "./GateOption.schema.json"
      }
    },
    "content": {
      "$ref": "./GateContent.schema.json"
    },
    "openedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "conclusion": {
      "$ref": "./ConclusionGateView.schema.json"
    },
    "workItems": {
      "type": "array",
      "items": {
        "$ref": "./WorkItemDraft.schema.json"
      }
    },
    "editable": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "title",
          "body",
          "acceptance",
          "role",
          "agent",
          "deps"
        ]
      }
    },
    "pr": {
      "$ref": "./PrSummary.schema.json"
    },
    "questionId": {
      "type": "string",
      "minLength": 1
    },
    "decision": {
      "type": "object",
      "properties": {
        "decision": {
          "$ref": "./GateDecision.schema.json"
        },
        "by": {
          "type": "string",
          "enum": [
            "user",
            "auto"
          ]
        },
        "at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "optionId": {
          "type": "string",
          "minLength": 1
        },
        "comment": {
          "type": "string"
        }
      },
      "required": [
        "decision",
        "by",
        "at"
      ]
    },
    "closedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "closeReason": {
      "type": "string",
      "enum": [
        "merged",
        "cancelled",
        "superseded"
      ]
    }
  },
  "required": [
    "gateId",
    "workflowId",
    "stageId",
    "kind",
    "title",
    "status",
    "version",
    "options",
    "content",
    "openedAt"
  ]
}
