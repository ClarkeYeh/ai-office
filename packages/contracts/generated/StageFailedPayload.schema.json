{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "stageId": {
      "type": "string",
      "minLength": 1
    },
    "attempt": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "reason": {
      "type": "string",
      "enum": [
        "timeout",
        "violation",
        "budget_hard_limit",
        "agent_failed",
        "cancelled",
        "other"
      ]
    },
    "detail": {
      "type": "string"
    }
  },
  "required": [
    "stageId",
    "attempt",
    "reason"
  ]
}
