{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "active": {
      "type": "boolean"
    },
    "attemptId": {
      "type": "string",
      "minLength": 1
    },
    "queue": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "current": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "active",
    "queue"
  ]
}
