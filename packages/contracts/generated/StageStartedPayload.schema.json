{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "stageId": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "$ref": "./StageKind.schema.json"
    },
    "attempt": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "mode": {
      "$ref": "./StageMode.schema.json"
    },
    "feedback": {
      "type": "string"
    },
    "agentOverride": {
      "$ref": "./AgentKind.schema.json"
    }
  },
  "required": [
    "stageId",
    "kind",
    "attempt",
    "mode"
  ]
}
