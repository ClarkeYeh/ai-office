{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "commandId": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "$ref": "./ExternalCommandKind.schema.json"
    },
    "error": {
      "$ref": "./ErrorInfo.schema.json"
    },
    "attempts": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "commandId",
    "kind",
    "error",
    "attempts"
  ]
}
