{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "seatId": {
      "$ref": "./SeatId.schema.json"
    },
    "attemptId": {
      "type": "string",
      "minLength": 1
    },
    "attempt": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "stageId": {
      "type": "string",
      "minLength": 1
    },
    "role": {
      "type": "string",
      "minLength": 1
    },
    "agent": {
      "$ref": "./AgentKind.schema.json"
    },
    "purpose": {
      "$ref": "./AttemptPurpose.schema.json"
    },
    "oncall": {
      "type": "boolean"
    },
    "keepOpen": {
      "type": "boolean"
    },
    "itemKey": {
      "$ref": "./WorkItemKey.schema.json"
    },
    "retryOf": {
      "type": "string",
      "minLength": 1
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "effort": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "spawnCommandId": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "seatId",
    "attemptId",
    "attempt",
    "stageId",
    "role",
    "agent",
    "purpose",
    "oncall",
    "keepOpen",
    "spawnCommandId"
  ]
}
