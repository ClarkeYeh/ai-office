{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "stageId": {
      "type": "string",
      "minLength": 1
    },
    "round": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "statements": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "absentAttemptIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "allReadyToConclude": {
      "type": "boolean"
    }
  },
  "required": [
    "stageId",
    "round",
    "statements",
    "absentAttemptIds",
    "allReadyToConclude"
  ]
}
