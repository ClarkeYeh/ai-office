{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "globalAgents": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "spawnStallMs": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "budgetEnforcement": {
      "type": "string",
      "enum": [
        "on",
        "off"
      ]
    },
    "workerBranchRetention": {
      "type": "string",
      "enum": [
        "delete-on-complete",
        "keep"
      ]
    }
  },
  "required": [
    "globalAgents"
  ]
}
