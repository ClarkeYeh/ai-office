{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "apiVersion": {
      "type": "string",
      "const": "ai-office/v1alpha1"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "roles": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "$ref": "./Role.schema.json"
      }
    },
    "defaults": {
      "type": "object",
      "properties": {
        "integrationBranch": {
          "type": "string",
          "minLength": 1
        },
        "maxReruns": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "budget": {
          "type": "object",
          "properties": {
            "hardLimitMultiplier": {
              "type": "number",
              "minimum": 1
            }
          },
          "required": [
            "hardLimitMultiplier"
          ]
        },
        "workflowBudget": {
          "type": "object",
          "properties": {
            "tokens": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "tokens"
          ]
        }
      },
      "required": [
        "integrationBranch",
        "maxReruns",
        "budget"
      ]
    },
    "stages": {
      "minItems": 1,
      "type": "array",
      "items": {
        "$ref": "./Stage.schema.json"
      }
    }
  },
  "required": [
    "apiVersion",
    "id",
    "name",
    "roles",
    "defaults",
    "stages"
  ],
  "$comment": "Also validate references, unique stage/gate IDs, kind order, and mandatory final-pr using WorkflowTemplateSchema in Zod; JSON Schema validates structure only."
}
