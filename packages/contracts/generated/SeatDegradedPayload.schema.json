{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "attemptId": {
      "type": "string",
      "minLength": 1
    },
    "reason": {
      "type": "string",
      "enum": [
        "no_transcript_source",
        "source_changed",
        "transcript_clipped"
      ]
    }
  },
  "required": [
    "attemptId",
    "reason"
  ]
}
