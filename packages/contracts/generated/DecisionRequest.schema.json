{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "reason": {
      "type": "string",
      "enum": [
        "unresolvable-conflict",
        "scope-change",
        "conflicts-with-conclusion",
        "other"
      ]
    },
    "question": {
      "type": "string"
    },
    "options": {
      "maxItems": 4,
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "questionId": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "reason",
    "question",
    "options"
  ]
}
