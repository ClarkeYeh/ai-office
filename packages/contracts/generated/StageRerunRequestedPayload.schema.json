{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "stageId": {
      "type": "string",
      "minLength": 1
    },
    "fromAttempt": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "mode": {
      "type": "string",
      "enum": [
        "rerun",
        "revision"
      ]
    },
    "by": {
      "type": "string",
      "enum": [
        "user",
        "auto"
      ]
    },
    "gateId": {
      "type": "string",
      "minLength": 1
    },
    "feedback": {
      "type": "string"
    },
    "agentOverride": {
      "$ref": "./AgentKind.schema.json"
    }
  },
  "required": [
    "stageId",
    "fromAttempt",
    "mode",
    "by"
  ]
}
