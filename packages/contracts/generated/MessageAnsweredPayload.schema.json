{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "questionId": {
      "type": "string",
      "minLength": 1
    },
    "by": {
      "type": "string",
      "enum": [
        "agent",
        "user"
      ]
    },
    "body": {
      "type": "string"
    },
    "attemptId": {
      "type": "string",
      "minLength": 1
    },
    "optionId": {
      "type": "string",
      "minLength": 1
    },
    "gateId": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "questionId",
    "by",
    "body"
  ]
}
