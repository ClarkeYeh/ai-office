{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "repoId": {
      "type": "string",
      "minLength": 1
    },
    "localPath": {
      "type": "string",
      "minLength": 1
    },
    "orcaRepoId": {
      "type": "string",
      "minLength": 1
    },
    "github": {
      "$ref": "./RepoScmRef.schema.json"
    },
    "defaultBranch": {
      "type": "string",
      "minLength": 1
    },
    "visibility": {
      "type": "string",
      "enum": [
        "public",
        "private"
      ]
    },
    "ownerLogin": {
      "type": "string",
      "minLength": 1
    },
    "defaultBranchProtected": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "string",
          "const": "unknown"
        }
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "registered",
        "invalid"
      ]
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "registeredAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    }
  },
  "required": [
    "repoId",
    "localPath",
    "orcaRepoId",
    "github",
    "defaultBranch",
    "visibility",
    "ownerLogin",
    "defaultBranchProtected",
    "status",
    "issues",
    "registeredAt",
    "updatedAt"
  ]
}
