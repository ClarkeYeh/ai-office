{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "optionId": {
      "type": "string",
      "minLength": 1
    },
    "label": {
      "type": "string",
      "minLength": 1
    },
    "input": {
      "type": "string",
      "enum": [
        "tokens",
        "agent",
        "text"
      ]
    }
  },
  "required": [
    "optionId",
    "label"
  ]
}
