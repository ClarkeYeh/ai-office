{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "questionId": {
      "type": "string",
      "minLength": 1
    },
    "to": {
      "type": "string",
      "enum": [
        "facilitator",
        "on-call"
      ]
    },
    "toAttemptId": {
      "type": "string",
      "minLength": 1
    },
    "retry": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1
    }
  },
  "required": [
    "questionId",
    "to",
    "toAttemptId",
    "retry"
  ]
}
