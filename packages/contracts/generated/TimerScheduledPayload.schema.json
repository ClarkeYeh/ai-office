{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "timerId": {
      "type": "string",
      "minLength": 1
    },
    "fireAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "payload": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "purpose": {
              "type": "string",
              "const": "round-timeout"
            },
            "stageId": {
              "type": "string",
              "minLength": 1
            },
            "round": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "purpose",
            "stageId",
            "round"
          ]
        },
        {
          "type": "object",
          "properties": {
            "purpose": {
              "type": "string",
              "const": "stage-timeout"
            },
            "stageId": {
              "type": "string",
              "minLength": 1
            },
            "attempt": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "purpose",
            "stageId",
            "attempt"
          ]
        },
        {
          "type": "object",
          "properties": {
            "purpose": {
              "type": "string",
              "const": "item-timeout"
            },
            "itemKey": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
            },
            "attemptId": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "purpose",
            "itemKey",
            "attemptId"
          ]
        },
        {
          "type": "object",
          "properties": {
            "purpose": {
              "type": "string",
              "const": "question-timeout"
            },
            "questionId": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "purpose",
            "questionId"
          ]
        },
        {
          "type": "object",
          "properties": {
            "purpose": {
              "type": "string",
              "const": "nudge-grace"
            },
            "attemptId": {
              "type": "string",
              "minLength": 1
            },
            "reason": {
              "type": "string",
              "enum": [
                "missing-submission",
                "round-timeout",
                "stage-timeout",
                "item-timeout",
                "question-timeout",
                "budget-wrap-up"
              ]
            }
          },
          "required": [
            "purpose",
            "attemptId",
            "reason"
          ]
        },
        {
          "type": "object",
          "properties": {
            "purpose": {
              "type": "string",
              "const": "gate-precheck"
            },
            "stageId": {
              "type": "string",
              "minLength": 1
            },
            "phase": {
              "type": "string",
              "enum": [
                "wait",
                "restop"
              ]
            }
          },
          "required": [
            "purpose",
            "stageId",
            "phase"
          ]
        },
        {
          "type": "object",
          "properties": {
            "purpose": {
              "type": "string",
              "const": "wallclock-hard-limit"
            },
            "stageId": {
              "type": "string",
              "minLength": 1
            },
            "itemKey": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
            },
            "attemptId": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "purpose",
            "stageId"
          ]
        }
      ]
    }
  },
  "required": [
    "timerId",
    "fireAt",
    "payload"
  ]
}
