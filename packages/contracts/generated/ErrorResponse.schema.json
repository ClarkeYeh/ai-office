{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "$ref": "./ErrorCategory.schema.json"
        },
        "message": {
          "type": "string"
        },
        "retryable": {
          "type": "boolean"
        },
        "details": {}
      },
      "required": [
        "code",
        "category",
        "message",
        "retryable"
      ]
    }
  },
  "required": [
    "error"
  ]
}
