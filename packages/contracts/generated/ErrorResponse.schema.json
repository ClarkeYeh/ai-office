{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string",
          "enum": [
            "transient",
            "rate_limited",
            "auth",
            "identity",
            "hijacked",
            "contract_mismatch",
            "permanent",
            "bug",
            "conflict",
            "validation",
            "guard"
          ]
        },
        "message": {
          "type": "string"
        },
        "retryable": {
          "type": "boolean"
        },
        "details": {}
      },
      "required": [
        "code",
        "category",
        "message",
        "retryable"
      ]
    }
  },
  "required": [
    "error"
  ]
}
