{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "templateId": {
      "type": "string",
      "minLength": 1
    },
    "repoId": {
      "type": "string",
      "minLength": 1
    },
    "requirement": {
      "type": "string",
      "minLength": 1
    },
    "roleOverrides": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "agent": {
            "type": "string",
            "enum": [
              "claude-code",
              "codex"
            ]
          },
          "effort": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ]
          }
        },
        "required": [
          "agent"
        ]
      }
    },
    "budgetOverrides": {
      "type": "object",
      "properties": {
        "stages": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "tokens": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "maxTurns": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "perItem": {
                "type": "object",
                "properties": {
                  "tokens": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  },
                  "maxTurns": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "tokens"
                ]
              }
            }
          }
        },
        "workflowBudget": {
          "type": "object",
          "properties": {
            "tokens": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "tokens"
          ]
        },
        "hardLimitMultiplier": {
          "type": "number",
          "minimum": 1
        }
      }
    },
    "gateToggles": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "acknowledgeUnverifiedRuntime": {
      "type": "boolean"
    }
  },
  "required": [
    "templateId",
    "repoId",
    "requirement"
  ]
}
