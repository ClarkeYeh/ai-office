{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "templateId": {
      "type": "string",
      "minLength": 1
    },
    "repoId": {
      "type": "string",
      "minLength": 1
    },
    "requirement": {
      "type": "string",
      "minLength": 1
    },
    "roleOverrides": {
      "$ref": "./RoleOverrides.schema.json"
    },
    "budgetOverrides": {
      "$ref": "./BudgetOverrides.schema.json"
    },
    "gateToggles": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "acknowledgeUnverifiedRuntime": {
      "type": "boolean"
    }
  },
  "required": [
    "templateId",
    "repoId",
    "requirement"
  ]
}
