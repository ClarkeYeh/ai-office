{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "rule": {
      "type": "string",
      "enum": [
        "orca-dispatch",
        "orca-run-use",
        "orca-worker-stop",
        "orca-agent-launch",
        "gh-merge",
        "gh-comment",
        "push-default-branch",
        "gh-label"
      ]
    },
    "severity": {
      "type": "string",
      "enum": [
        "high",
        "medium"
      ]
    },
    "messageId": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "rule",
    "severity",
    "messageId"
  ]
}
