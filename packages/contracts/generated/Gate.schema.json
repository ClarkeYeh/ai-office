{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "optional": {
      "type": "boolean"
    },
    "editable": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "title",
          "body",
          "acceptance",
          "role",
          "agent",
          "deps"
        ]
      }
    }
  },
  "required": [
    "id",
    "title"
  ]
}
