{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "attemptId": {
      "type": "string",
      "minLength": 1
    },
    "reason": {
      "type": "string",
      "enum": [
        "missing-submission",
        "round-timeout",
        "stage-timeout",
        "item-timeout",
        "question-timeout",
        "review-timeout",
        "budget-wrap-up",
        "spawn-stall"
      ]
    },
    "subject": {
      "type": "string",
      "minLength": 1
    },
    "body": {
      "type": "string"
    }
  },
  "required": [
    "attemptId",
    "reason",
    "subject",
    "body"
  ]
}
