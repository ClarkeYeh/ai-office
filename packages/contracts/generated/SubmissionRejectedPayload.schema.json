{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "reason": {
      "$ref": "./SubmissionRejectionReason.schema.json"
    },
    "kind": {
      "$ref": "./SubmissionKind.schema.json"
    },
    "attemptId": {
      "type": "string",
      "minLength": 1
    },
    "detail": {
      "type": "string"
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "message"
        ]
      }
    }
  },
  "required": [
    "reason"
  ]
}
