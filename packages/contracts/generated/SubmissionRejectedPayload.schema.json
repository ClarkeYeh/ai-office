{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "reason": {
      "type": "string",
      "enum": [
        "schema",
        "identity_mismatch",
        "not_allowed",
        "gate_open"
      ]
    },
    "kind": {
      "type": "string",
      "enum": [
        "agenda",
        "statement",
        "conclusion",
        "work-items",
        "answer-question",
        "merge-request",
        "decision-request",
        "integration-report"
      ]
    },
    "attemptId": {
      "type": "string",
      "minLength": 1
    },
    "detail": {
      "type": "string"
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "message"
        ]
      }
    }
  },
  "required": [
    "reason"
  ]
}
