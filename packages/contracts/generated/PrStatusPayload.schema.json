{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "pr": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "state": {
      "type": "string",
      "enum": [
        "open",
        "closed",
        "merged"
      ]
    },
    "base": {
      "type": "string",
      "minLength": 1
    },
    "head": {
      "type": "string",
      "minLength": 1
    },
    "headSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{7,64}$"
    },
    "mergeable": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "checks": {
      "type": "string",
      "enum": [
        "pending",
        "success",
        "failure",
        "none"
      ]
    },
    "mergedBy": {
      "type": "string",
      "minLength": 1
    },
    "mergeCommitSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{7,64}$"
    }
  },
  "required": [
    "pr",
    "state",
    "base",
    "head",
    "headSha",
    "mergeable"
  ]
}
