{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "itemKey": {
      "$ref": "./WorkItemKey.schema.json"
    },
    "attemptId": {
      "type": "string",
      "minLength": 1
    },
    "attempt": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "agent": {
      "$ref": "./AgentKind.schema.json"
    },
    "branch": {
      "type": "string",
      "format": "starts_with",
      "pattern": "^ai-office\\/.*"
    },
    "workspaceName": {
      "type": "string",
      "minLength": 1
    },
    "retryOf": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "itemKey",
    "attemptId",
    "attempt",
    "agent",
    "branch",
    "workspaceName"
  ]
}
