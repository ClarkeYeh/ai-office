{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "const": "accepted"
        },
        "submissionId": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "status",
        "submissionId"
      ]
    },
    {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "const": "merged"
        },
        "submissionId": {
          "type": "string",
          "minLength": 1
        },
        "pr": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "mergeCommitSha": {
          "type": "string",
          "pattern": "^[0-9a-f]{7,64}$"
        }
      },
      "required": [
        "status",
        "submissionId",
        "pr",
        "mergeCommitSha"
      ]
    },
    {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "const": "pending"
        },
        "submissionId": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "status",
        "submissionId"
      ]
    },
    {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "const": "failed"
        },
        "submissionId": {
          "type": "string",
          "minLength": 1
        },
        "pr": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "reason": {
          "$ref": "./MergeFailureReason.schema.json"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "status",
        "submissionId",
        "pr",
        "reason",
        "message"
      ]
    }
  ]
}
